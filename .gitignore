target/
dist/
build/
*.rlib
*.rmeta

# Logs / scratch
*.log
*.tmp
*.out

# Local runtime state
data/
*.db
*.sqlite
*.sqlite3

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
