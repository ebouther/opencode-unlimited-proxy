# Copy to `.env` (git-ignored) and edit before the first `docker compose up`.
#
# Cloudflare WARP terms of service -- explicit opt-in.
#
# The WARP node images run the Cloudflare WARP client, governed by the
# Cloudflare Application Terms of Service:
#   https://www.cloudflare.com/application/terms/
#
# Section 3 states the client "is not designed to hide your identity" from the
# sites you reach. Rotating egress to appear as several different users is
# outside that intent. Read the terms, then set this to 1 to accept them.
#
# Leave it at 0 (or omit it) and the WARP nodes refuse to start with an
# explanatory message.
WARP_ACCEPT_TOS=0

# Local API key the engine accepts. Must match `server_keys` in config.json.
# Change it if the engine is reachable from anything other than localhost.
# OPENCODE2API_SERVER_KEYS=sk-change-me

# Engine-managed WARP pool (warp.enabled: true in config.json).
#
# A routed IPv6 /64 the engine may bind individual source addresses from. Each
# WARP exit then gets its own egress /64, which is the block the free-tier quota
# is counted in. Without it, WARP falls back to the host's default source and
# the pool can share one exhausted bucket.
#
# Find yours with: ip -6 addr show scope global
# Example: WARP_SOURCE_IPV6=2001:db8:1234:5678::/64
WARP_SOURCE_IPV6=