[Unit]
Description=OpenCode Unlimited Proxy Gateway
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Adjust WorkingDirectory to the absolute path where you cloned this repo /stack
WorkingDirectory=/opt/opencode-unlimited-proxy/stack
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose restart
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
